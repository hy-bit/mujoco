			<Synthetic Name="eq_solimp">
				<DisplayString>eq_solimp[{neq}][5]</DisplayString>
				<Expand>
					<Item Name="size">neq*5</Item>
					<ArrayItems>
						<Size>neq*5</Size>
						<ValuePointer>eq_solimp</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="eq_data">
				<DisplayString>eq_data[{neq}][11]</DisplayString>
				<Expand>
					<Item Name="size">neq*11</Item>
					<ArrayItems>
						<Size>neq*11</Size>
						<ValuePointer>eq_data</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>

			<!-- ======== sparse inertia matrix (M) ======== -->
			<Synthetic Name="M_rownnz">
				<DisplayString>M_rownnz[{nv}]</DisplayString>
				<Expand>
					<Item Name="size">nv</Item>
					<ArrayItems>
						<Size>nv</Size>
						<ValuePointer>M_rownnz</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="M_rowadr">
				<DisplayString>M_rowadr[{nv}]</DisplayString>
				<Expand>
					<Item Name="size">nv</Item>
					<ArrayItems>
						<Size>nv</Size>
						<ValuePointer>M_rowadr</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="M_colind">
				<DisplayString>M_colind[{nC}]</DisplayString>
				<Expand>
					<Item Name="size">nC</Item>
					<ArrayItems>
						<Size>nC</Size>
						<ValuePointer>M_colind</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>


			<Item Name="names">names</Item>
		</Expand>
	</Type>
</AutoVisualizer>