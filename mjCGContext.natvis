<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="_mjCGContext">
    <DisplayString>
		{{is_sparse={is_sparse}, is_elliptic={is_elliptic}, island={island}, nv={nv}, ne={ne}, nf={nf}, nefc={nefc}, nJ={nJ}, cost={cost}, scale={scale}}}
	</DisplayString>
    <Expand>
		<!-- dof arrays 

		<Item Name="is_sparse">is_sparse</Item>
      <Item Name="is_elliptic">is_elliptic</Item>
      <Item Name="island">island</Item>
      <Item Name="nv">nv</Item>
      <Item Name="ne">ne</Item>
      <Item Name="nf">nf</Item>
      <Item Name="nefc">nefc</Item>
      <Item Name="nJ">nJ</Item>
      <Item Name="cost">cost</Item>
      <Item Name="scale">scale</Item>
      <Item Name="nactive">nactive</Item>
      <Item Name="ncone">ncone</Item>
      <Item Name="nupdate">nupdate</Item>
      <Item Name="LSiter">LSiter</Item>
      <Item Name="LSresult">LSresult</Item>
      <Item Name="LSslope">LSslope</Item>
		-->
		
		<!-- dof arrays -->
		<Synthetic Name="qfrc_smooth">
			<DisplayString>qfrc_smooth[nv]</DisplayString>
			<Expand>
				<ArrayItems>
					<Size>nv</Size>
					<ValuePointer>qfrc_smooth</ValuePointer>
				</ArrayItems>
			</Expand>
		</Synthetic>

		<Synthetic Name="qacc_smooth">
			<DisplayString>qacc_smooth[nv]</DisplayString>
