<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="mjPrimalContext">
    <DisplayString>
		{{is_sparse={is_sparse}, is_elliptic={is_elliptic}, island={island}, nv={nv}, ne={ne}, nf={nf}, nefc={nefc}, nJ={nJ}, nH={nH}, nL={nL}, cost={cost}, scale={scale}, flg_metric={flg_metric}, cone_fold={cone_fold}}}
	</DisplayString>
    <Expand>
		<!-- dof arrays -->
		<Synthetic Name="qfrc_smooth">
			<DisplayString>qfrc_smooth[nv]</DisplayString>
			<Expand>
				<ArrayItems>
