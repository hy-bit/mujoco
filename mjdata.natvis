<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<!-- MuJoCo mjData visualization -->
	<Type Name="mjData_">
		<DisplayString>{{time={time}, ncon={ncon}, nefc={nefc}}}</DisplayString>
		<Expand>
			<Item Name="time">time</Item>
			<Item Name="energy[0]">energy[0]</Item>
			<Item Name="energy[1]">energy[1]</Item>
			<Item Name="ncon">ncon</Item>
			<Item Name="nefc">nefc</Item>

			<!-- ======== state ======== -->
			<Synthetic Name="qpos">
				<DisplayString>qpos</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->nq</Size>
						<ValuePointer>qpos</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="qvel">
				<DisplayString>qvel</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->nq</Size>
						<ValuePointer>qvel</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="act">
				<DisplayString>act</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->nq</Size>
						<ValuePointer>act</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>

			<!-- ======== dynamics ======== -->
			<Synthetic Name="qacc">
				<DisplayString>qacc</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->nq</Size>
						<ValuePointer>qacc</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="act_dot">
				<DisplayString>act_dot[{m->na}]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->na</Size>
						<ValuePointer>act_dot</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>

			<Synthetic Name="ctrl">
				<DisplayString>ctrl</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->nq</Size>
						<ValuePointer>ctrl</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="contact">
				<DisplayString>contact[{ncon}]</DisplayString>
				<Expand>
					<Item Name="size">ncon</Item>
					<ArrayItems>
						<Size>m->nq</Size>
						<ValuePointer>contact</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>

			<!-- ======== sensors ======== -->
			<Synthetic Name="sensordata">
				<DisplayString>sensordata[[{m->nsensordata}]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->nsensordata</Size>
						<ValuePointer>sensordata</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>

			<!-- ======== computed by mj_fwdPosition/mj_kinematics ======== -->
			<Synthetic Name="xpos">
				<DisplayString>xpos[{m->nbody}][3]</DisplayString>
				<Expand>
					<ArrayItems>
						<Size>m->nbody*3</Size>
						<ValuePointer>xpos</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="xquat">
				<DisplayString>xquat[{m->nbody}][4]</DisplayString>
				<Expand>
					<Item Name="size">m->nbody*4</Item>
					<ArrayItems>
						<Size>m->nbody*4</Size>
						<ValuePointer>xquat</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="xmat">
				<DisplayString>xmat[{m->nbody}][9]</DisplayString>
				<Expand>
					<Item Name="size">m->nbody*9</Item>
					<ArrayItems>
						<Size>m->nbody*9</Size>
						<ValuePointer>xmat</ValuePointer>
