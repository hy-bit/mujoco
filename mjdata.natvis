				<Expand>
					<Item Name="size">m->njnt*3</Item>
					<ArrayItems>
						<Size>m->njnt*3</Size>
						<ValuePointer>xaxis</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="geom_xpos">
				<DisplayString>geom_xpos[{m->ngeom}][3]</DisplayString>
				<Expand>
					<Item Name="size">m->ngeom*3</Item>
					<ArrayItems>
						<Size>m->ngeom*3</Size>
						<ValuePointer>geom_xpos</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="geom_xmat">
				<DisplayString>geom_xmat[{m->ngeom}][9]</DisplayString>
				<Expand>
					<Item Name="size">m->ngeom*9</Item>
					<ArrayItems>
						<Size>m->ngeom*9</Size>
						<ValuePointer>geom_xmat</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="site_xpos">
				<DisplayString>site_xpos[{m->nsite}][3]</DisplayString>
