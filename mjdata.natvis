			<Synthetic Name="site_xmat">
				<DisplayString>site_xmat[{m->nsite}][9]</DisplayString>
				<Expand>
					<Item Name="size">m->nsite*9</Item>
					<ArrayItems>
						<Size>m->nsite*9</Size>
						<ValuePointer>site_xmat</ValuePointer>
					</ArrayItems>
				</Expand>
