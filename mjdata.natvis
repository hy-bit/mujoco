			<Synthetic Name="ximat">
				<DisplayString>ximat[{m->nbody}][9]</DisplayString>
				<Expand>
					<Item Name="size">m->nbody*9</Item>
					<ArrayItems>
						<Size>m->nbody*9</Size>
						<ValuePointer>ximat</ValuePointer>
					</ArrayItems>
				</Expand>
			</Synthetic>
			<Synthetic Name="xanchor">
				<DisplayString>xanchor[{m->njnt}][3]</DisplayString>
				<Expand>
					<Item Name="size">m->njnt*3</Item>
					<ArrayItems>
						<Size>m->njnt*3</Size>
